{
  "name": "@philiprehberger/sorted-array",
  "version": "0.1.0",
  "description": "Sorted array with binary search — maintains order on insert",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sorted",
    "array",
    "binary-search",
    "collection",
    "ordered",
    "data-structure"
  ],
  "author": "philiprehberger",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philiprehberger/ts-sorted-array.git"
  },
  "bugs": {
    "url": "https://github.com/philiprehberger/ts-sorted-array/issues"
  },
  "homepage": "https://github.com/philiprehberger/ts-sorted-array#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
